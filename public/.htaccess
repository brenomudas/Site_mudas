# Ensure correct MIME types for Sitemap & Robots
AddType application/xml .xml
AddType text/plain .txt

# Turn on Compression (Gzip / Deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml image/x-icon
</IfModule>

# Cache-Control Headers for Static Files
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Media
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Stylesheets & Scripts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Force Cache-Control Headers for all static extensions
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# 301 Permanent Redirects for Legacy URLs & Single Page Application (SPA) Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Case-insensitive 301 Redirects for Legacy Product URLs indexed in Google
  RewriteCond %{REQUEST_URI} ^/produtos.* [NC,OR]
  RewriteCond %{REQUEST_URI} ^/produto.* [NC,OR]
  RewriteCond %{REQUEST_URI} (Goiabeira|Paluma|Tailandesa|BRS-Guaraca|Guaraca) [NC]
  RewriteRule ^.*$ https://saofranciscomudas.com/#mudas [R=301,L,NE]

  # 301 Redirects for Legacy Pages
  RewriteRule ^empresa.*$ https://saofranciscomudas.com/#sobre [R=301,L,NC,NE]
  RewriteRule ^contato.*$ https://saofranciscomudas.com/#mudas [R=301,L,NC,NE]
  RewriteRule ^index\.php$ https://saofranciscomudas.com/ [R=301,L,NC]

  # SPA Fallback Rules
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>